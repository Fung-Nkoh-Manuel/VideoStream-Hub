# ---- Core ----
# MongoDB Atlas free tier works fine: https://www.mongodb.com/cloud/atlas
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/videostream-hub"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ---- Google Sign-In (VideoStream Hub account login — separate from YouTube) ----
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Cloudinary (video/image storage — required for uploads) ----
# https://cloudinary.com/console — free tier is enough to start
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- YouTube Data/Live API (Destinations > Connect YouTube) ----
# Same Google Cloud project as above; enable "YouTube Data API v3".
# Live-broadcast scopes require OAuth consent screen verification.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/destinations/youtube/callback"

# ---- TikTok Content Posting API ----
# Requires TikTok Developer app approval: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/destinations/tiktok/callback"

# ---- Meta (Facebook Pages/Live API) ----
# Requires a Meta App with Pages, pages_show_list, publish_video permissions
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/destinations/facebook/callback"

# ---- Streaming relay provider (multistream engine) ----
# Abstracted in src/lib/streaming-provider.ts. Point this at any provider
# that offers "create stream / add destination / start / stop" (an
# API-driven RTMP relay service). Leave blank to keep Live Studio in
# "Setup Required" mode — Vercel cannot host a persistent RTMP server
# itself, so a relay provider is required for real multistreaming.
STREAM_PROVIDER_API_KEY=""
STREAM_PROVIDER_API_URL=""

# ---- Vercel Cron (scheduling) ----
# Any random string — sent as a Bearer token so /api/cron/* can verify the
# request actually came from Vercel Cron and not the public internet.
CRON_SECRET="generate-a-random-string"

# ---- AI metadata generation (optional, "Generate with AI" button) ----
ANTHROPIC_API_KEY=""
